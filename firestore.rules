rules_version = '2';

// Default deny-all rules. The current app version uses Cloud Functions for
// all server-side logic and does not write to Firestore from the client.
// When client-side reads/writes are introduced, replace these rules with
// authenticated, scoped rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
