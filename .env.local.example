# Firebase Web SDK 設定（公開值，安全靠 GCP HTTP referrer 限制）
# 取得方式：firebase apps:sdkconfig WEB <appId> --project=<project-id>
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

# 站台對外網址（用於 OG metadata）
NEXT_PUBLIC_SITE_URL=http://localhost:9002

# Cloudflare Turnstile site key（公開值；後端 secret key 透過 GCP Secret Manager 注入）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...

# === 下面只在 functions/ 端使用，不放這個檔！ ===
# Gemini API Key 透過 Firebase Secret Manager 注入：
# echo "AIzaSy..." | gcloud secrets versions add GEMINI_API_KEY --data-file=- --project=<project>
